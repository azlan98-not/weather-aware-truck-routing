# Backend environment overrides — all optional; the app runs keyless with defaults.
# Copy to .env (or export in the shell / set in your host's dashboard).

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — comma-separated origins of the frontend allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database — leave unset for the SQLite default (db.sqlite3).
# PostgreSQL example: DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# External provider base URLs (keyless public services; override for self-hosted instances)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
